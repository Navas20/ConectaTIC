{
  "version": 2,
  "outputDirectory": "build/web",
  "devCommand": "flutter run -d chrome",
  "routes": [
    { "handle": "filesystem" },
    { "src": "^/(.*)", "dest": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
