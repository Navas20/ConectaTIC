{
  "version": 2,
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "Backend/**"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "api/index.js"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/assets/(.*)",
      "dest": "/frontend/conectatic_app/build/web/assets/$1"
    },
    {
      "src": "/videos/(.*)",
      "dest": "/frontend/conectatic_app/build/web/videos/$1"
    },
    {
      "src": "/icons/(.*)",
      "dest": "/frontend/conectatic_app/build/web/icons/$1"
    },
    {
      "src": "/(.*\\.(js|json|html|css|png|ico|svg|woff|woff2|ttf|frag|wasm|map))",
      "dest": "/frontend/conectatic_app/build/web/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/frontend/conectatic_app/build/web/index.html"
    }
  ],
  "env": {
    "NODE_ENV": "production"
  }
}
